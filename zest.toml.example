# Zest starter configuration.
#
# Copy this file to `zest.toml` only when you intentionally want project-local
# provider settings. Otherwise Zest creates and manages `~/.zest/zest.toml`
# for the machine. Credentials never belong in this file.

[providers.codex]
kind = "codex_cli"
command = "codex"
model = "gpt-5.6-sol"
allow_mcp = false
timeout_secs = 900

[default]
provider = "codex"
model = "gpt-5.6-sol"

[tools]
# A tool result larger than this is stored under `.zest/spill/<chat-id>/` and the
# model gets a bounded preview plus the path, which it can read or grep. Set to 0
# to keep every result inline however large.
#
# Must stay above the `[tools.bash]` header below: TOML would otherwise read a
# bare key here as part of that table.
max_result_bytes = 32768

[tools.bash]
# Read-only commands can run without an extra approval; other commands ask.
enabled = true

# The `gateway` kind was removed with the bundled CLIProxyAPI sidecar. An
# existing `kind = "gateway"` entry still loads: `codex` and `claude` are
# migrated in memory to the CLI kinds below, anything else is skipped with a
# reason, and this file is never rewritten for you.
#
# OpenAI-compatible providers are configured explicitly when needed. Their
# API keys are stored in the OS credential manager, not here.
# The native Anthropic API can be added from the launch picker as well; its key
# uses the same credential manager and does not become part of this file.
#
# [providers.anthropic]
# kind = "anthropic"
# model = "claude-opus-5"
# credential = "anthropic"
#
# Claude Code can also be the parent provider for the whole Zest session. Run
# `claude login`, then uncomment this block and set `default.provider = "claude"`.
# It uses the Claude Code subscription and does not delegate through `[agents]`.
# [providers.claude]
# kind = "claude_code"
# command = "claude"
# model = "sonnet"
# models = ["sonnet", "opus"]
# allow_mcp = false
# permission_mode = "default"
# timeout_secs = 900
#
# [providers.deepseek]
# kind = "openai_compatible"
# base_url = "https://api.deepseek.com"
# model = "deepseek-v4-flash"
# models = ["deepseek-v4-flash", "deepseek-v4-pro"]
# credential = "deepseek"
# api_key_env = "DEEPSEEK_API_KEY"
#
# [providers.openai]
# kind = "openai_compatible"
# base_url = "https://api.openai.com/v1"
# model = "gpt-5"
# credential = "openai"

# Zest's own MCP servers are optional, and are reached by the chat provider
# itself. Add them from Customize > MCPs, or here.
#
# These are not `zest serve`. That command is an inbound coordinator MCP for
# feature cards. Its policy (`gated` or `trusted`) is a CLI flag / env var,
# not a key here. `[mcp.*]` is outbound: Zest calls those servers from a chat.
#
# These are not the same thing as `allow_mcp` above: that lets a CLI use the MCP
# servers configured in *its* own settings, which Zest never sees. A Claude Code
# or Codex parent runs its own agent loop, so it uses that path and ignores the
# servers below. Everything else — an Anthropic key, or an OpenAI-compatible
# endpoint such as DeepSeek — has no CLI behind it, and this is the only way
# such a chat can reach an MCP server.
#
# GitHub is the starter. It stays off until you paste a personal access token
# in Customize > MCPs. The token is stored in the OS credential manager, not
# here. Every MCP tool call is still approval-gated.
[mcp.github]
url = "https://api.githubcopilot.com/mcp/"
enabled = false
timeout_secs = 120

# A local process instead of a URL. `env_vars` lists variable *names* only.
# [mcp.github-local]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-github"]
# env_vars = ["GITHUB_TOKEN"]
# enabled = true
# timeout_secs = 120

# External workers are optional. Authenticate their CLIs separately, then
# enable a worker here or from Settings > CLI delegation. The optional model
# is owned by the worker CLI and is independent from the Zest chat model.
#
# [agents.claude]
# mode = "headless"
# command = "claude"
# args = ["--print", "--output-format", "stream-json", "--strict-mcp-config", "--model", "{model}", "{prompt}"]
# model = "sonnet"
# allow_mcp = false
# workspace = "isolated"
# timeout_secs = 900
#
# `mode = "headless"` means this worker is an external CLI. It is not
# `zest serve` and not `zest run --jsonl`.
#
# [agents.gemini]
# mode = "acp"
# command = "gemini"
# args = ["--acp", "--model", "{model}"]
# model = "gemini-2.5-pro"
# allow_mcp = false
# workspace = "isolated"
# timeout_secs = 900
