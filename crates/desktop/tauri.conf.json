{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zest",
  "version": "0.2.1",
  "identifier": "dev.zest.app",
  "build": {
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Zest",
        "width": 1100,
        "height": 720,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https: http:; font-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$TEMP/**", "$HOME/**", "$DOWNLOAD/**", "$PICTURE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/zest-icon-32.png",
      "icons/zest-icon-128.png",
      "icons/zest-icon-512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
