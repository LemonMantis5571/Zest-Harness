# Copy to .env — .env is gitignored.
#
# Codex and Claude subscriptions need nothing here: they are reached through
# their own CLIs. Sign in with `codex login` / `claude login`, or from the
# desktop picker.

# Optional overrides
# ZEST_MODEL=gpt-5.6-terra
# ZEST_EFFORT=high

# Native Anthropic (when you add [providers.anthropic] back in zest.toml)
# ANTHROPIC_API_KEY=sk-ant-...
