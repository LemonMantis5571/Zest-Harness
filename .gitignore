# --- Build artifacts ---
/target/
**/*.rs.bk
*.tsbuildinfo

# --- Secrets / local env ---
.env
.env.*
!.env.example
# Machine-specific signing overlay (thumbprint is public, but the file names a
# certificate only this machine has). The .example stays committed.
crates/desktop/tauri.signing.conf.json

# --- Project-local Zest state (do not commit chat history or personal prompts) ---
.zest/threads/
.zest/runs/
.zest/interrupts/
.zest/spill/
.zest/last-thread-id
.zest/system.md
.zest/doctor*
.zest/*.json
# Skills are personal and installed outside the repository.
.zest/skills/

# Local/project configuration. Use zest.toml.example for a shareable starter.
zest.toml
# Desktop runtime state is machine-local and must never enter the repository.
crates/desktop/.zest/

# --- Local tool downloads ---
/tools/*
!/tools/.gitkeep
crates/desktop/binaries/

# --- Node (npm workspaces at repo root) ---
node_modules/
crates/desktop/ui/dist/
crates/desktop/ui/.vite/

# --- Tauri generated ---
crates/desktop/gen/
crates/desktop/src-tauri/target/

# --- Editor / OS ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Agent skill installs (optional local copies) ---
.agents/
.claude/
.cursor/skills/
.windsurf/

# --- Private agent context & memory ---
/context/
/memory/

# --- Private local plans ---
/plans/

# --- Local agent instructions and maintainer notes ---
/AGENTS.md
/CONTEXT.md
/PROJECT_CONTEXT.md
/DESIGN.md
/context/
/memory/
/references/
/skills/
/tools/
/docs/adr/
/docs/CODEBASE_AUDIT.md

# --- Scratch / local experiments ---
# ACP probe transcripts: local captures that quote workspace content.
/outputs/acp-probe/
# Generated media does not belong in output reports. Intentional app/document
# assets belong in the relevant assets/ or docs/ directory and need review.
/outputs/**/*.aac
/outputs/**/*.aif
/outputs/**/*.aiff
/outputs/**/*.avif
/outputs/**/*.avi
/outputs/**/*.bmp
/outputs/**/*.flac
/outputs/**/*.gif
/outputs/**/*.heic
/outputs/**/*.heif
/outputs/**/*.jpeg
/outputs/**/*.jpg
/outputs/**/*.m4a
/outputs/**/*.m4v
/outputs/**/*.mkv
/outputs/**/*.mov
/outputs/**/*.mp3
/outputs/**/*.mp4
/outputs/**/*.mpeg
/outputs/**/*.mpg
/outputs/**/*.ogg
/outputs/**/*.png
/outputs/**/*.tif
/outputs/**/*.tiff
/outputs/**/*.wav
/outputs/**/*.webm
/outputs/**/*.webp
/outputs/**/*.wmv
/tmp/
*.log
*.tmp
.cache/

# --- Release artifacts (regenerated by scripts/release-checksums.mjs) ---
/SHA256SUMS.txt
