{
  "name": "zest",
  "private": true,
  "workspaces": [
    "crates/desktop",
    "crates/desktop/ui"
  ],
  "engines": {
    "node": "24.16.0",
    "npm": "11.21.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.2"
    }
  },
  "scripts": {
    "dev": "npm run desktop:dev",
    "dev:official": "npm run dev:official -w zest-desktop",
    "ui:dev": "npm run dev -w ui",
    "ui:build": "npm run build -w ui",
    "ui:lint": "npm run lint -w ui",
    "ui:lint:plugins": "npm run lint:plugins -w ui",
    "ui:test": "npm run test -w ui",
    "ui:e2e": "npm run test:e2e -w ui",
    "desktop:dev": "npm run dev -w zest-desktop",
    "desktop:build": "npm run build -w zest-desktop",
    "desktop:smoke": "node ./scripts/desktop-smoke.mjs",
    "verify": "node ./scripts/dev-verify.mjs",
    "output-policy:check": "node ./scripts/check-output-artifacts.mjs",
    "output-policy:test": "node --test ./scripts/check-output-artifacts.test.mjs",
    "features": "node ./scripts/feature-map.mjs",
    "features:check": "node ./scripts/feature-map.mjs check",
    "features:test": "node --test ./scripts/feature-map.test.mjs",
    "control": "node ./scripts/zest-control.mjs",
    "control:check": "node ./scripts/zest-control.mjs check",
    "control:test": "node --test ./scripts/zest-control.test.mjs",
    "hooks:install": "node ./scripts/install-git-hooks.mjs",
    "acp:probe": "node ./scripts/acp-probe.mjs",
    "plugin:install": "node ./scripts/install-plugin.mjs",
    "release:version": "node ./scripts/check-release-version.mjs",
    "release:checksums": "node ./scripts/release-checksums.mjs"
  }
}
